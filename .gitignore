# Ignore files generated by IDEs
.idea/
.vscode/

# Ignore build artifacts
build/
dist/
node_modules/

# Ignore environment-specific files
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production


# Ignore logs and cache files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js

# Ignore environment-specific files in each main folder
frontend/**/.env*
backend/**/.env
contracts/**/.env*

# Ignore npm lock files (this project uses Yarn)
package-lock.json


# Yarn 4
.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions
